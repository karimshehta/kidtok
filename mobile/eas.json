{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production"
    },
    "production-snap-staging": {
      "extends": "production",
      "environment": "preview",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_SNAP_CAMERA_KIT_FORCE_STAGING": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6753696049"
      },
      "android": {
        "track": "production"
      }
    },
    "production-snap-staging": {
      "extends": "production"
    }
  }
}
