{
  "expo": {
    "name": "KidTok",
    "slug": "kidtok",
    "version": "2.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kidtok",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kidtok.kidtok",
      "buildNumber": "62",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:kidtok.vercel.app",
        "webcredentials:kidtok.vercel.app"
      ],
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.kidtok.app",
            "CFBundleURLSchemes": [
              "kidtok"
            ]
          }
        ],
        "NSCameraUsageDescription": "يستخدم التطبيق الكاميرا لتسجيل الفيديوهات.",
        "NSMicrophoneUsageDescription": "يستخدم التطبيق الميكروفون لتسجيل الصوت مع الفيديو.",
        "NSLocationWhenInUseUsageDescription": "يستخدم KidTok موقعك التقريبي أثناء استخدام التطبيق لتخصيص المحتوى الآمن حسب بلدك وتحسين تجربة الطفل. لا يتم تتبع موقعك في الخلفية.",
        "NSPhotoLibraryUsageDescription": "يحتاج التطبيق للوصول إلى الصور لاختيار الفيديوهات وتغيير الصورة الشخصية.",
        "NSPhotoLibraryAddUsageDescription": "يحتاج التطبيق إلى الإذن لحفظ الفيديوهات في مكتبة الصور.",
        "NSFaceIDUsageDescription": "يستخدم التطبيق Face ID للتحقق عند الخروج من وضع الطفل.",
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.kidtok.app",
      "versionCode": 40,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kidtok.vercel.app",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "kidtok.vercel.app",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "kidtok"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "يستخدم التطبيق الكاميرا لتسجيل الفيديوهات.",
          "microphonePermission": "يستخدم التطبيق الميكروفون لتسجيل الصوت مع الفيديو.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج التطبيق للوصول إلى الصور والفيديوهات.",
          "cameraPermission": "يستخدم التطبيق الكاميرا لالتقاط الصور."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#03BBE5",
          "defaultChannel": "default",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9534911590158193~7470202921",
          "iosAppId": "ca-app-pub-9534911590158193~4621290062",
          "skAdNetworkItems": []
        }
      ],
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "useLegacyPackaging": false
          },
          "ios": {
            "newArchEnabled": false,
            "deploymentTarget": "15.5"
          }
        }
      ],
      "./plugins/withAndroid16KbSupport",
      "./plugins/withSnapCameraKit",
      "./plugins/withKidTokVideoTools",
      "react-native-compressor",
      "expo-video",
      "expo-audio",
      "expo-web-browser",
      "expo-asset"
    ],
    "runtimeVersion": "1.0.0",
    "owner": "karimshehta",
    "updates": {
      "url": "https://u.expo.dev/fb2d9f4c-1ee3-4e3f-953b-6373f1665c6d",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "SUPABASE_URL": "https://ngjpmfldzoijtfyxopjw.supabase.co",
      "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5nanBtZmxkem9panRmeXhvcGp3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg1MzQzNjMsImV4cCI6MjA5NDExMDM2M30.St75N5VZR-eeWi8HvhelcAY144c6u6yJdGdzCyt44gA",
      "router": {},
