{
  "expo": {
    "name": "KidTok",
    "slug": "kidtok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kidtok",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#03BBE5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kidtok.app",
      "associatedDomains": [
        "applinks:kidtok.vercel.app"
      ],
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.kidtok.app",
            "CFBundleURLSchemes": [
              "kidtok"
            ]
          }
        ],
        "NSCameraUsageDescription": "\u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0641\u064a\u062f\u064a\u0648\u0647\u0627\u062a.",
        "NSMicrophoneUsageDescription": "\u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646 \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0635\u0648\u062a \u0645\u0639 \u0627\u0644\u0641\u064a\u062f\u064a\u0648.",
        "NSPhotoLibraryAddUsageDescription": "\u064a\u062d\u062a\u0627\u062c \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0625\u0644\u0649 \u0627\u0644\u0625\u0630\u0646 \u0644\u062d\u0641\u0638 \u0627\u0644\u0641\u064a\u062f\u064a\u0648\u0647\u0627\u062a.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#03BBE5"
      },
      "package": "com.kidtok.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kidtok.vercel.app",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "kidtok.vercel.app",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "kidtok"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "\u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0641\u064a\u062f\u064a\u0648\u0647\u0627\u062a.",
          "microphonePermission": "\u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646 \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0635\u0648\u062a \u0645\u0639 \u0627\u0644\u0641\u064a\u062f\u064a\u0648.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#03BBE5",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-auth-session"
    ],
    "experiments": {
