{
  "expo": {
    "name": "KidTok",
    "slug": "kidtok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kidtok",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#03BBE5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kidtok.app",
      "associatedDomains": [
        "applinks:kidtok.vercel.app"
      ],
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true },
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.kidtok.app",
            "CFBundleURLSchemes": ["kidtok"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#03BBE5"
      },
      "package": "com.kidtok.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "kidtok.vercel.app", "pathPrefix": "/auth" },
            { "scheme": "https", "host": "kidtok.vercel.app", "pathPrefix": "/reset-password" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            { "scheme": "kidtok" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "SUPABASE_URL": "https://ngjpmfldzoijtfyxopjw.supabase.co",
      "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5nanBtZmxkem9panRmeXhvcGp3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg1MzQzNjMsImV4cCI6MjA5NDExMDM2M30.St75N5VZR-eeWi8HvhelcAY144c6u6yJdGdzCyt44gA"
    }
  }
}
